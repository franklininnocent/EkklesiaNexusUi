{
  "name": "ekklesia-soft-ui",
  "version": "1.0.0",
  "description": "EkklesiaNexus - Multi-tenant SaaS Application",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "perf:bundle": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:ci": "jest --runInBand --reporters=default --reporters=jest-junit",
    "test:coverage": "jest --runInBand --coverage",
    "test:watch": "jest --watch",
    "lint": "npm run lint:tokens && npm run lint:styles && ng lint",
    "lint:styles": "node scripts/lint-styles-ratchet.mjs",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "generate:legacy-compat": "node scripts/generate-legacy-compat.mjs",
    "e2e": "ng e2e",
    "e2e:rbac": "playwright test e2e/tenant-rbac.spec.ts e2e/mass-schedule-week.spec.ts",
    "e2e:donations-plans": "playwright test e2e/donations-plans.spec.ts",
    "e2e:cross-tenant": "playwright test e2e/cross-tenant-isolation.spec.ts",
    "e2e:sacraments": "playwright test e2e/sacraments",
    "e2e:church-profile-leadership": "playwright test e2e/church-profile/church-profile.spec.ts -g leadership",
    "e2e:church-profile": "playwright test e2e/church-profile/church-profile.spec.ts",
    "e2e:bishops": "playwright test e2e/bishop-management",
    "e2e:bishop-create": "playwright test e2e/bishop-management/bishop-create-modal.spec.ts",
    "e2e:bishop-list-edit": "playwright test e2e/bishop-management/bishop-list-edit.spec.ts",
    "e2e:bishop-succession": "playwright test e2e/bishop-management/bishop-succession-lifecycle.spec.ts",
    "e2e:subscription-expired": "playwright test e2e/subscription",
    "e2e:subscription-enforcement": "playwright test e2e/subscription/view-only-locked-enforcement.spec.ts",
    "e2e:application-access": "playwright test e2e/application-access.spec.ts",
    "e2e:nav-isolation": "playwright test e2e/navigation/tenant-ekklesia-isolation.spec.ts"
  },
  "private": true,
  "overrides": {
    "glob": "^11.0.0",
    "rimraf": "^6.0.0"
  },
  "dependencies": {
    "@angular/animations": "22.2.3",
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@angular/router": "22.2.3",
    "@ng-select/ng-select": "24.2.1",
    "@ngrx/effects": "22.0.1",
    "@ngrx/store": "22.0.1",
    "@ngrx/store-devtools": "22.0.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "chart.js": "4.5.1",
    "chartjs-chart-sankey": "0.15.0",
    "libphonenumber-js": "1.13.15",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.0",
    "zone.js": "0.16.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "angular-eslint": "22.5.0",
    "eslint": "^10.12.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.4.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-junit": "^16.0.0",
    "jest-preset-angular": "17.0.3",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss-scss": "4.0.9",
    "stylelint": "17.16.0",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
